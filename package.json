{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "clean": "rm -rf dist && echo 'Done.'",
    "build": "bun build index.html --outdir ./dist && cp -R public/. dist/ && echo 'Done.'",
    "check:content": "bun scripts/content-check.mjs",
    "preview": "bun x serve dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest",
    "sharp": "^0.34.5",
    "typescript": "latest"
  },
  "module": "index.ts"
}
